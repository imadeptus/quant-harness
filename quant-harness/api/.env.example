# quant-harness verdict API — copy to .env (git-ignored, never committed or baked
# into the image) and export, or pass with `docker run --env-file`.
# Every value is optional; the defaults below are what an unset variable means.
# Keep comments on their own lines: `docker run --env-file` takes values literally,
# so `X=1  # note` would set X to "1  # note".

# --- request limits ---------------------------------------------------------------
# max rows (configurations) per request -> 413 above
QH_MAX_CONFIGS=200
# max bars per row -> 413 above
QH_MAX_PERIODS=50000
# 64 MiB raw request body -> 413 above
QH_MAX_BODY_BYTES=67108864

# --- auth (empty = open) ------------------------------------------------------------
# Comma-separated list of accepted X-API-Key values. Empty = no auth: do not expose
# an open instance to the internet without a reverse proxy that rate-limits.
QH_API_KEYS=

# --- payments (STUBS: 402 challenge only, no verification — see api/README.md) -----
# noop | x402 | nowpayments
QH_PAYMENT_GATE=noop
# x402 and nowpayments are stubs and refuse to start unless you opt in explicitly:
QH_ALLOW_STUB_PAYMENT_GATE=
# x402: both required when QH_PAYMENT_GATE=x402
# receiving address, e.g. 0x...
QH_X402_PAY_TO=
# price per call in USDC, e.g. 0.05
QH_X402_PRICE_USDC=
# set to a mainnet (e.g. base) for real money
QH_X402_NETWORK=base-sepolia
# set to the USDC token contract on that network
QH_X402_ASSET=USDC
# nowpayments: required when QH_PAYMENT_GATE=nowpayments
NOWPAYMENTS_API_KEY=
# only quoted in the 402 instructions
QH_NOWPAYMENTS_PRICE_USDC=

# --- misc ---------------------------------------------------------------------------
# used as the x402 `resource` URL
QH_PUBLIC_URL=http://localhost:8000
QH_LOG_LEVEL=INFO
# Docker only
PORT=8000
